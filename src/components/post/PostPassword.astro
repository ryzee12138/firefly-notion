---
interface Props {
	passwordHash?: string;
	postId: string;
}

const { passwordHash, postId } = Astro.props;
const hasPassword = !!passwordHash;
---

{
	hasPassword ? (
		<div class="password-protected-content" data-post-id={postId} data-password-hash={passwordHash}>
			<div class="password-form card-base p-8 text-center">
				<div class="mb-4">
					<svg
						class="w-16 h-16 mx-auto text-(--primary)"
						fill="none"
						stroke="currentColor"
						viewBox="0 0 24 24"
						xmlns="http://www.w3.org/2000/svg"
					>
						<path
							stroke-linecap="round"
							stroke-linejoin="round"
							stroke-width="2"
							d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
						/>
					</svg>
				</div>
				<h3 class="text-xl font-bold mb-2 text-black/90 dark:text-white/90">文章已加密</h3>
				<p class="text-sm text-black/60 dark:text-white/60 mb-6">此文章受密码保护，请输入密码查看</p>

				<div class="flex flex-col gap-3 max-w-xs mx-auto">
					<input
						type="password"
						class="password-input w-full px-4 py-3 rounded-lg border border-(--line-divider) bg-transparent text-black/90 dark:text-white/90 focus:outline-none focus:border-(--primary) transition"
						placeholder="输入密码"
						autocomplete="off"
					/>
					<button class="password-submit w-full px-4 py-3 bg-(--primary) text-white dark:text-black/70 rounded-lg font-medium hover:opacity-90 active:scale-95 transition-all">
						解锁文章
					</button>
				</div>

				<p class="password-error text-sm text-red-500 mt-3 hidden">密码错误，请重试</p>
			</div>

			<div class="protected-content hidden">
				<slot />
			</div>
		</div>
	) : (
		<slot />
	)
}

<script>
	// 简单的 SHA-256 哈希函数
	async function sha256(message: string): Promise<string> {
		const encoder = new TextEncoder();
		const data = encoder.encode(message);
		const hashBuffer = await crypto.subtle.digest("SHA-256", data);
		const hashArray = Array.from(new Uint8Array(hashBuffer));
		return hashArray.map((b) => b.toString(16).padStart(2, "0")).join("").slice(0, 16);
	}

	// 检查本地存储中的解锁状态
	function isUnlocked(postId: string, passwordHash: string | null): boolean {
		if (typeof sessionStorage === "undefined") return false;
		if (!passwordHash) return false;
		const key = `notion_post_unlocked_${postId}`;
		return sessionStorage.getItem(key) === passwordHash;
	}

	// 设置解锁状态
	function setUnlocked(postId: string, passwordHash: string): void {
		if (typeof sessionStorage === "undefined") return;
		const key = `notion_post_unlocked_${postId}`;
		sessionStorage.setItem(key, passwordHash);
	}

	// 初始化密码保护
	function initPasswordProtection() {
		const containers = document.querySelectorAll(".password-protected-content");

		containers.forEach((container) => {
			const postId = container.getAttribute("data-post-id");
			const passwordHash = container.getAttribute("data-password-hash");

			if (!postId || !passwordHash) return;

			const passwordForm = container.querySelector(".password-form") as HTMLElement;
			const content = container.querySelector(".protected-content") as HTMLElement;
			const input = container.querySelector(".password-input") as HTMLInputElement;
			const button = container.querySelector(".password-submit") as HTMLButtonElement;
			const error = container.querySelector(".password-error") as HTMLElement;

			if (!passwordForm || !content) return;

			// 检查是否已解锁
			if (passwordHash && isUnlocked(postId, passwordHash)) {
				passwordForm.classList.add("hidden");
				content.classList.remove("hidden");
				return;
			}

			// 验证密码
			async function verifyPassword() {
				const enteredPassword = input?.value.trim();
				if (!enteredPassword) return;

				const hashed = await sha256(enteredPassword);

				if (passwordHash && hashed === passwordHash) {
					// 密码正确
					setUnlocked(postId, passwordHash!);
					passwordForm.classList.add("hidden");
					content.classList.remove("hidden");
					error?.classList.add("hidden");
				} else {
					// 密码错误
					error?.classList.remove("hidden");
					input?.classList.add("border-red-500");
					setTimeout(() => {
						input?.classList.remove("border-red-500");
					}, 2000);
				}
			}

			button?.addEventListener("click", verifyPassword);

			input?.addEventListener("keydown", (e) => {
				if (e.key === "Enter") {
					e.preventDefault();
					verifyPassword();
				}
			});
		});
	}

	// 页面加载时初始化
	document.addEventListener("DOMContentLoaded", initPasswordProtection);
	// 对于 Astro 的 view transitions
	document.addEventListener("astro:page-load", initPasswordProtection);
</script>
