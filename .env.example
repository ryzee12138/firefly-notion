# ==========================================
# Firefly Notion 数据源配置
# ==========================================

# 内容来源: file | notion
CONTENT_SOURCE=notion

# ==========================================
# Notion API 配置
# ==========================================

# Notion 认证模式: official (官方API) | compat (兼容模式，预留)
NOTION_AUTH_MODE=official

# Notion Integration Token
# 获取方式: https://www.notion.so/my-integrations
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Notion 数据库 ID
# 从数据库页面 URL 中获取: https://www.notion.so/workspace/xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx?v=...
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ==========================================
# Notion API 行为配置
# ==========================================

# API 超时时间 (毫秒)
NOTION_TIMEOUT_MS=30000

# 重试次数
NOTION_RETRY=3

# 并发请求上限
NOTION_CONCURRENCY=5

# ==========================================
# 同步模式配置
# ==========================================

# 同步模式: manual (手动) | polling (轮询) | webhook (Webhook触发)
SYNC_MODE=polling

# 轮询间隔 (分钟), SYNC_MODE=polling 时有效
POLL_INTERVAL_MIN=60

# ==========================================
# 部署触发配置 (用于主动更新)
# ==========================================

# 部署 Hook URL (Vercel/Netlify/Cloudflare Pages 等提供的 Deploy Hook)
# 示例: https://api.vercel.com/v1/integrations/deploy/...
REBUILD_HOOK_URL=

# 部署触发 Token (用于验证触发请求)
REBUILD_TOKEN=

# 最小重建间隔 (秒), 防止频繁触发
MIN_REBUILD_GAP_SEC=300

# ==========================================
# 图片处理配置
# ==========================================

# 图片处理策略: notion (直接使用Notion链接) | download (构建时下载到本地)
# 注意: Notion 图片链接有有效期，生产环境建议使用 download
IMAGE_STRATEGY=download

# 下载图片的缓存目录 (相对于项目根目录)
IMAGE_CACHE_DIR=public/images/notion

# ==========================================
# 密码保护配置
# ==========================================

# 文章密码保护的盐值 (用于前端密码校验)
# 生成方式: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PASSWORD_SALT=your_random_salt_here
